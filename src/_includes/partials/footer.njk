<footer class="border-t border-ink-900/5 bg-primary-900 text-cream-100">
  <div class="mx-auto max-w-container px-6 py-16 md:px-10">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="font-display text-xl font-medium text-cream-50">{{ site.name }}</p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-cream-100/70">{{ site.tagline }}</p>
        <div class="mt-6 flex gap-3">
          {% for network in ["facebook", "google", "youtube"] %}
          <a href="#" aria-label="{{ network }}" class="flex h-9 w-9 items-center justify-center rounded-full bg-cream-50/10 text-cream-50 hover:bg-cream-50/20">
            {% if network == "facebook" %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><path d="M14 9h2V6h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V9z"/></svg>
            {% elif network == "google" %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><circle cx="12" cy="12" r="8"/><path d="M8 12h8M12 8v8"/></svg>
            {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10 9.5l5 2.5-5 2.5v-5z"/></svg>
            {% endif %}
          </a>
          {% endfor %}
        </div>
      </div>

      <div>
        <p class="text-sm font-medium text-cream-50">Visit Us</p>
        <p class="mt-3 text-sm text-cream-100/70">{{ site.address.full }}</p>
        <a href="{{ site.phoneHref }}" class="mt-2 block text-sm text-cream-100/70 hover:text-cream-50">{{ site.phone }}</a>
        <a href="mailto:{{ site.email }}" class="mt-1 block text-sm text-cream-100/70 hover:text-cream-50">{{ site.email }}</a>
      </div>

      <div>
        <p class="text-sm font-medium text-cream-50">Office Hours</p>
        <ul class="mt-3 space-y-1 text-sm text-cream-100/70">
          {% for h in site.hours %}
          <li class="flex justify-between gap-4">
            <span>{{ h.days }}</span>
            <span>{{ h.time }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse items-center justify-between gap-4 border-t border-cream-50/10 pt-6 text-xs text-cream-100/50 md:flex-row">
      <p>&copy; {% year %} {{ site.name }}. All rights reserved.</p>
      <nav class="flex gap-6">
        {% for item in site.nav %}
        <a href="{{ item.href }}" class="hover:text-cream-50">{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </div>
</footer>
